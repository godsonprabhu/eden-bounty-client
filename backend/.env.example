# Database Configuration (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5433
DB_USER=eb_db_user
DB_PASSWORD=CHANGE_ME_LOCAL_DEVELOPMENT_PASSWORD
DB_NAME=eden_bounty_db

# Asynchronous SQLAlchemy Database URL (asyncpg)
# In Docker network use: postgresql+asyncpg://eb_db_user:${DB_PASSWORD}@postgres:5432/eden_bounty_db
# On host with mapped port 5433 use: postgresql+asyncpg://eb_db_user:${DB_PASSWORD}@localhost:5433/eden_bounty_db
DATABASE_URL=postgresql+asyncpg://eb_db_user:CHANGE_ME_LOCAL_DEVELOPMENT_PASSWORD@localhost:5433/eden_bounty_db
