# EDEN BOUNTY Sdn. Bhd. — production environment template
# Copy to `.env.production` ON THE SERVER ONLY (git-ignored, chmod 600). Never commit real values.
# Compose reads this file for ${...} interpolation only; each container gets an explicit allow-list.
# Full reference: PRODUCTION_ENVIRONMENT_VARIABLES.md

# ---- Domain / TLS (Caddy) -------------------------------------------------
SITE_DOMAIN=edenbounty.org
ACME_EMAIL=info@edenbounty.org
# Leave empty in production. `local_certs` is only for local validation without a public domain.
CADDY_GLOBAL_OPTIONS=
RELEASE_TAG=replace-with-immutable-release-tag

# ---- API ------------------------------------------------------------------
APP_ENV=production
DEBUG=false
CORS_ORIGINS=["https://edenbounty.org","https://www.edenbounty.org"]

# ---- Database (managed PostgreSQL) ----------------------------------------
# Supabase: use the Supavisor SESSION pooler (port 5432, IPv4 on all plans), not transaction mode (6543).
# postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?ssl=require
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30

# ---- Edge proxy (only if Cloudflare's proxy is enabled later) ---------------
TRUSTED_CLOUDFLARE_PROXIES=[]

# ---- Outbound mail (keep disabled until SMTP is verified) -------------------
# With SMTP disabled, invitation and reset links are shown once to the issuing administrator
# instead of being emailed (see SECURITY_AUDIT.md, "Invitation and reset links").
SMTP_ENABLED=false
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
OPERATIONS_NOTIFY_EMAIL=info@edenbounty.org

# ---- Content-Security-Policy (frontend) --------------------------------------
# enforce (default) | report-only | off. Optional endpoint that receives violation reports.
CSP_MODE=enforce
CSP_REPORT_URI=
# ---- Investor document malware scanning ---------------------------------------
# off | clamav  (clamav requires `--profile scan`; uploads are refused while the scanner is down)
DOCUMENT_SCAN_MODE=off
# ---- Optional self-hosted Postgres (profile: selfhosted-db) -----------------
PG_DB=eden_bounty
PG_USER=eb_app
PG_PASSWORD=
